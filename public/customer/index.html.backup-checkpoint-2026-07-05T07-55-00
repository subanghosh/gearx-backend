                    <div id="make-dropdown" class="search-dropdown-menu"></div>
                </div>
                <input type="text" id="v-model" class="input" placeholder="Enter Model (e.g., M340i)" style="background: #1C1F26; border: 1px solid rgba(255,255,255,0.05); padding: 16px; font-size: 1rem; font-weight: 600; border-radius: 12px; width: 100%; color: #fff; box-shadow: inset 0 2px 4px rgba(0,0,0,0.2);">
            </div>
        </div>

        <!-- Fuel Type Selection -->
        <div class="form-group mb-20">
            <label style="font-size: 0.85rem; color: #a1a1aa; text-transform: uppercase; letter-spacing: 1px; font-weight: 600; margin-bottom: 12px; display: block;">FUEL TYPE</label>
            <div id="fuel-container" class="horizontal-swipe">
                <!-- Dynamically populated -->
            </div>
            <input type="hidden" id="v-fuel" value="Petrol">
        </div>

        <!-- Transmission Selection -->
        <div id="transmission-group" class="form-group mb-20">
            <label style="font-size: 0.85rem; color: #a1a1aa; text-transform: uppercase; letter-spacing: 1px; font-weight: 600; margin-bottom: 12px; display: block;">TRANSMISSION</label>
            <div style="display:flex; gap:12px;">
                <button type="button" id="trans-Manual" class="fuel-btn active" style="flex: 1;" onclick="selectTransmission('Manual')">Manual</button>
                <button type="button" id="trans-Automatic" class="fuel-btn inactive" style="flex: 1;" onclick="selectTransmission('Automatic')">Automatic</button>
            </div>
            <input type="hidden" id="v-transmission" value="Manual">
        </div>

        <!-- Car Color Selection -->
        <div id="car-color-group" class="form-group mb-20" style="display: block;">
            <label style="font-size: 0.85rem; color: #a1a1aa; text-transform: uppercase; letter-spacing: 1px; font-weight: 600; margin-bottom: 12px; display: block;">CAR COLOR</label>
            <div id="color-swatch-container" style="display: flex; flex-wrap: wrap; gap: 10px; padding-bottom: 4px;">
                <!-- Populated by JS -->
            </div>
            <input type="hidden" id="v-color" value="White">
        </div>

        <!-- Seats Selection -->
        <div id="car-seats-group" class="form-group mb-20" style="display: block;">
            <label style="font-size: 0.85rem; color: #a1a1aa; text-transform: uppercase; letter-spacing: 1px; font-weight: 600; margin-bottom: 12px; display: block;">NUMBER OF SEATS</label>
            <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                <button type="button" id="seats-2" class="fuel-btn inactive" style="flex: 1 0 auto; min-width: 56px;" onclick="selectVehicleSeats('2')">2</button>
                <button type="button" id="seats-4" class="fuel-btn inactive" style="flex: 1 0 auto; min-width: 56px;" onclick="selectVehicleSeats('4')">4</button>
                <button type="button" id="seats-5" class="fuel-btn active" style="flex: 1 0 auto; min-width: 56px;" onclick="selectVehicleSeats('5')">5</button>
                <button type="button" id="seats-6" class="fuel-btn inactive" style="flex: 1 0 auto; min-width: 56px;" onclick="selectVehicleSeats('6')">6</button>
                <button type="button" id="seats-7" class="fuel-btn inactive" style="flex: 1 0 auto; min-width: 56px;" onclick="selectVehicleSeats('7')">7</button>
                <button type="button" id="seats-8" class="fuel-btn inactive" style="flex: 1 0 auto; min-width: 56px;" onclick="selectVehicleSeats('8')">8</button>
            </div>
            <input type="hidden" id="v-seats" value="5">
        </div>

        <script>
        (function initVehicleColorPicker() {
            const COLORS = [
                { name: 'White',  hex: '#f1f5f9' },
                { name: 'Black',  hex: '#1e293b' },
                { name: 'Silver', hex: '#94a3b8' },
                { name: 'Grey',   hex: '#6b7280' },
                { name: 'Red',    hex: '#ef4444' },
                { name: 'Blue',   hex: '#3b82f6' },
                { name: 'Green',  hex: '#22c55e' },
                { name: 'Brown',  hex: '#92400e' },
                { name: 'Orange', hex: '#f97316' },
                { name: 'Yellow', hex: '#facc15' },
                { name: 'Purple', hex: '#a855f7' },
                { name: 'Beige',  hex: '#d4b896' },
                { name: 'Gold',   hex: '#d4af37' },
                { name: 'Maroon', hex: '#7f1d1d' },
                { name: 'Navy',   hex: '#1e3a5f' },
            ];
            const container = document.getElementById('color-swatch-container');
            if (!container) return;
            container.innerHTML = COLORS.map(c => `
                <button type="button" id="color-swatch-${c.name}" title="${c.name}"
                    onclick="selectVehicleColor('${c.name}')"
                    style="width: 36px; height: 36px; border-radius: 50%; background: ${c.hex}; border: 2px solid ${ c.name === 'White' ? '#facc15' : 'transparent'}; cursor: pointer; transition: all 0.2s; box-shadow: ${ c.name === 'White' ? '0 0 0 3px rgba(250,204,21,0.3)' : '0 2px 6px rgba(0,0,0,0.4)'}; flex-shrink: 0;"
                    aria-label="${c.name}"></button>
            `).join('');
        })();
        </script>

        <!-- Save Button -->
        <input type="hidden" id="v-edit-id" value="">
        <div style="margin-top: 20px;">
            <button id="btn-submit-vehicle" class="btn btn-success"
                style="width:100%; padding:12px 16px; font-weight:700; font-size:1rem; display:flex; align-items:center; justify-content:center; gap:8px; border-radius:8px; background: #15803D; color: #fff; border: none; box-shadow: 0 4px 12px rgba(21, 128, 61, 0.3);"
                onclick="saveVehicle()">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
                Save Vehicle
            </button>
        </div>

    </div> <!-- /inner wrapper -->
</div>
</body>

</html>



