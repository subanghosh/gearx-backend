<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ReDrivo - Car Service App</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

    <script>
        window.googleMapsReady = false;
        window.onGoogleMapsLoaded = function() {
            window.googleMapsReady = true;
            if (typeof window.initCustomerMap === 'function') {
                window.initCustomerMap();
            }
        };
    </script>
    <script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyBdPccZc8vH4N0YdIePz2yjrcXoKlC9LRU&libraries=places&v=weekly&callback=onGoogleMapsLoaded" async defer></script>
    <script src="https://thirsty-strung-overstep.ngrok-free.dev/socket.io/socket.io.js"></script>
    <script src="https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js"></script>
    <link rel="stylesheet" href="styles.css?v=202605251321">
    <script>
    window.onerror = function(message, source, lineno, colno, error) {
        alert("Global Error: " + message + "\nLine: " + lineno + "\nSource: " + source);
        return false;
    };
    window.addEventListener('unhandledrejection', function(event) {
        alert("Unhandled Promise Rejection: " + event.reason);
    });
    </script>
</head>

<body>
        <!-- Splash / Loading Screen -->
    <div id="splash-screen" style="position: fixed; inset: 0; background: #F8A002; z-index: 99999; display: flex; flex-direction: column; align-items: center; justify-content: center; transition: opacity 0.5s ease-out;">
        <div style="text-align: center; display: flex; flex-direction: column; align-items: center; justify-content: center;">
            <img src="assets/redrivo_logo_full.png" alt="ReDrivo Logo" style="width: 80%; max-width: 320px; height: auto; animation: splashLogoAnim 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) forwards; opacity: 0; transform: scale(0.8);" />
            <div style="margin-top: 12px; font-family: 'Inter', sans-serif; font-size: 20px; font-weight: 700; color: #1E1E1E; opacity: 0; animation: splashSloganAnim 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) forwards; animation-delay: 0.3s; letter-spacing: -0.5px;">Drive on, fikar gone</div>
        </div>
        <style>
            @keyframes splashLogoAnim {
                0% { opacity: 0; transform: scale(0.8); }
                100% { opacity: 1; transform: scale(1); }
            }
            @keyframes splashSloganAnim {
                0% { opacity: 0; transform: translateY(10px); }
                100% { opacity: 1; transform: translateY(0); }
            }
        </style>
    </div>

    <div id="login-container" class="auth-container" style="position: relative; overflow-y: auto; overflow-x: hidden; background: #0B0E14; display: flex; align-items: center; justify-content: center; min-height: 100vh; width: 100%;">
        <!-- Premium Background Elements -->
        <div style="position: absolute; top: -10%; left: -10%; width: 50vw; height: 50vw; background: radial-gradient(circle, rgba(255, 215, 0, 0.05) 0%, rgba(0,0,0,0) 70%); border-radius: 50%; pointer-events: none;"></div>
        <div style="position: absolute; bottom: -10%; right: -10%; width: 50vw; height: 50vw; background: radial-gradient(circle, rgba(255, 215, 0, 0.03) 0%, rgba(0,0,0,0) 70%); border-radius: 50%; pointer-events: none;"></div>

        <div class="auth-card fade-in" style="z-index: 1; width: 90%; max-width: 480px; background: rgba(18, 22, 29, 0.7); backdrop-filter: blur(20px); border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 24px; box-shadow: 0 24px 60px rgba(0, 0, 0, 0.5);">
            <div style="text-align: center; margin-bottom: 30px;">
                <div style="display: flex; justify-content: center; align-items: center; width: 64px; height: 64px; background: linear-gradient(135deg, rgba(250, 204, 21, 0.15) 0%, rgba(250, 204, 21, 0.05) 100%); border: 1.5px solid rgba(250, 204, 21, 0.3); border-radius: 20px; margin: 0 auto 20px; box-shadow: 0 8px 24px rgba(250, 204, 21, 0.15);">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#facc15" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                        <circle cx="12" cy="11" r="3"></circle>
                        <path d="M12 2v2"></path>
                    </svg>
                </div>
                <h1 class="logo-text" style="font-size: 2.5rem; font-weight: 800; color: #FFFFFF; letter-spacing: -1px; margin-bottom: 8px;">Re<span style="color: #FACC15;">D</span>rivo</h1>
                <p class="subtitle" style="font-size: 0.95rem; color: #8B949E; font-weight: 500;">Premium Auto Service</p>
            </div>

            <!-- OTP Login/Signup Flow -->
            <div id="signup-tab">
                <!-- STEP 1: PHONE -->
                <div id="su-step-phone">
                    <div class="form-group" style="margin-bottom: 24px;">
                        <label style="display:block; font-size:0.8rem; color:#8B949E; margin-bottom:12px; text-transform:uppercase; letter-spacing:1px; font-weight: 700;">Mobile Number</label>
                        <div class="phone-input-group" style="background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 16px; height: 56px; transition: all 0.3s ease;">
                            <span class="prefix" style="background: transparent; border-right: 1px solid rgba(255, 255, 255, 0.1); color: #8B949E; font-weight: 600; padding: 0 20px;">+91</span>
                            <input type="tel" id="su-phone" placeholder="Enter your 10-digit number" maxlength="10" style="background: transparent; border: none; outline: none; padding-left: 20px; font-size: 1.1rem; letter-spacing: 1px; color: #FFFFFF; font-weight: 500; width: 100%;">
                        </div>
                    </div>

                    <div id="su-otp-area" style="display:none; margin: 24px 0; padding: 16px 8px; background: rgba(255, 215, 0, 0.05); border: 1px solid rgba(255, 215, 0, 0.15); border-radius: 16px;">
                        <label style="display:block; font-size:0.8rem; color:#FFD700; margin-bottom:16px; text-transform:uppercase; letter-spacing: 1px; font-weight: 700; text-align: center;">Enter Verification Code</label>
                        <div class="otp-boxes" data-target="su-otp">
                            <input class="otp-box" type="text" maxlength="1" inputmode="numeric" pattern="[0-9]" autocomplete="one-time-code">
                            <input class="otp-box" type="text" maxlength="1" inputmode="numeric" pattern="[0-9]">
                            <input class="otp-box" type="text" maxlength="1" inputmode="numeric" pattern="[0-9]">
                            <input class="otp-box" type="text" maxlength="1" inputmode="numeric" pattern="[0-9]">
                            <input class="otp-box" type="text" maxlength="1" inputmode="numeric" pattern="[0-9]">
                            <input class="otp-box" type="text" maxlength="1" inputmode="numeric" pattern="[0-9]">
                        </div>
                        <input type="hidden" id="su-otp" value="">
                        <p style="text-align:center; margin-top:24px; font-size:0.9rem; color:#8B949E;">
                            Didn't receive the code? <br><a id="resend-otp-link" href="javascript:void(0)" onclick="resendOTP()" style="color:#FFD700; font-weight:600; text-decoration:none; display: inline-block; margin-top: 8px; transition: opacity 0.2s;">Resend OTP</a>
                        </p>
                    </div>
                </div>

                <button id="btn-signup-step1" class="btn btn-primary" style="width:100%; margin-top:20px; padding: 16px; font-size: 1.1rem; font-weight: 700; border-radius: 16px; background: #FFD700; color: #000000; border: none; cursor: pointer; transition: transform 0.2s, background 0.2s;" onclick="handleSignupStep1()">Continue</button>
                <button id="btn-signup-step2" class="btn btn-primary" style="width:100%; margin-top:20px; padding: 16px; font-size: 1.1rem; font-weight: 700; border-radius: 16px; background: #FFD700; color: #000000; border: none; cursor: pointer; display:none; transition: transform 0.2s, background 0.2s;" onclick="handleSignupStep2()">Verify & Secure Login</button>
                
                <p style="text-align: center; font-size: 0.75rem; color: #8B949E; margin-top: 24px; line-height: 1.4;">
                    By logging in, you agree to our <a href="javascript:void(0)" onclick="openTermsModal(); return false;" style="color: #FFD700; text-decoration: underline;">Terms & Conditions</a> and <a href="javascript:void(0)" onclick="openPrivacyModal(); return false;" style="color: #FFD700; text-decoration: underline;">Privacy Policy</a>.
                </p>
            </div>
        </div>
    </div>

    <div id="app-container" class="hidden" style="position: relative; min-height: 100vh; overflow-x: hidden;">
        <nav class="navbar" style="display: flex; justify-content: space-between; align-items: center; padding: 24px; background: transparent; position: absolute; top: 0; left: 0; width: 100%; z-index: 100; border-bottom: none; backdrop-filter: none; -webkit-backdrop-filter: none;">
            <div style="display: flex; align-items: center; gap: 10px;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#facc15" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="filter: drop-shadow(0 2px 8px rgba(250, 204, 21, 0.4));">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                    <circle cx="12" cy="11" r="3"></circle>
                </svg>
                <h2 class="logo-text" style="font-weight: 800; font-size: 1.6rem; color: #ffffff; letter-spacing: -1px; text-shadow: 0 2px 10px rgba(0,0,0,0.5); margin: 0;">Re<span style="color: #FACC15;">D</span>rivo</h2>
            </div>
            <div style="display: flex; align-items: center; gap: 16px;">
                <div class="profile-section-top" style="display: flex; align-items: center; gap: 12px; cursor: pointer;" onclick="switchTab('profile')" title="Profile">
                    <span id="header-user-name" style="font-size: 0.95rem; font-weight: 600; color: var(--text-main); display: none;">User</span>
                    <div style="width: 42px; height: 42px; border-radius: 50%; overflow: hidden; border: 2.5px solid var(--primary); box-shadow: 0 0 12px rgba(250, 204, 21, 0.4); background: var(--bg-card); display: flex; align-items: center; justify-content: center;">
                        <img id="header-user-avatar" src="https://lh3.googleusercontent.com/aida-public/AB6AXuABsEd33qhqnOLpk4D-DvhoQSiDTBFX884YwiFnEmv8FI7WNP0YINcLLkw6Dyu_ACVjZw4NqX97j1x080R3P0YEKEiau4OnGVHPu8cXTMAsWagtF8VpSUQR2DcCDUwUJmONpDbD6L4FyqHqsXgbAG54l3AAYf5eJiVy4iTC6eTKhlCRenXtqnFoWQpakSUms4capxEdm3gLHbuMzb0NlOqF9IxJlojFeLh5opMYXEZctKCZ5FaHtXk_JLl0FCzCjC3ZXe9TEAgxK1g" alt="Profile" style="width: 100%; height: 100%; object-fit: cover;">
                    </div>
                </div>
            </div>
        </nav>

        <!-- Full-screen Leaflet Map Background -->
        <div id="leaflet-map" style="position: absolute; top: 0; left: 0; width: 100%; height: 100vh; z-index: 0; background-color: #0f172a;"></div>

        <!-- Floating Center Pin for Pickup Selection (Rapido Style) -->
        <div id="center-pickup-pin" style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -100%); z-index: 5; pointer-events: none; display: none; flex-direction: column; align-items: center;">
            <div id="center-pin-tooltip" style="background: rgba(18, 22, 29, 0.95); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); color: #fff; padding: 6px 12px; border-radius: 20px; font-size: 0.72rem; font-weight: 800; white-space: nowrap; margin-bottom: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.08); display: flex; align-items: center; gap: 6px;">
                <span style="display: inline-block; width: 6px; height: 6px; background: #38bdf8; border-radius: 50%;"></span>
                Pin Pickup Location
            </div>
            <div style="width: 18px; height: 18px; background: #0284c7; border-radius: 50%; border: 3.5px solid #fff; box-shadow: 0 4px 15px rgba(2, 132, 199, 0.6); position: relative;">
                <div style="position: absolute; top: -6px; left: -6px; width: 24px; height: 24px; border: 2.5px solid #0284c7; border-radius: 50%; animation: pulse 2s infinite ease-in-out;"></div>
            </div>
        </div>



        <main class="container fade-in" style="position: relative; z-index: 10;">
            
            <!-- Dashboard Tab (Map + Bottom sheet Garage) -->
            <div id="garage-container-wrapper" style="width: 100%; display: flex; flex-direction: column; gap: 20px; min-height: calc(100vh - 120px);">
                
                <!-- Floating Location Selector at Top of Screen -->
                <div class="location-select-container" style="position: relative; margin-top: 80px; width: 100%; z-index: 1000; display: flex; flex-direction: column; gap: 4px; background: rgba(18, 22, 29, 0.95); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); padding: 10px 14px; border-radius: 18px; border: 1px solid rgba(255, 255, 255, 0.08); box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);">
                    <label style="font-size: 0.72rem; color: #fff; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; display: flex; align-items: center; gap: 5px;">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#facc15" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                        Pickup Location
                    </label>
                    <div style="position: relative; width: 100%;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: #facc15;"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                        <input type="text" 
                            id="pickup-location-global"
                            placeholder="Enter your current location" 
                            style="width: 100%; padding: 10px 12px 10px 36px; border-radius: 10px; border: 1px solid rgba(250, 204, 21, 0.4); background: rgba(0,0,0,0.5); color: #fff; font-size: 0.95rem; font-weight: 600; outline: none; transition: all 0.3s ease;"
                            autocomplete="off"
                            data-lat=""
                            data-lng=""
                            data-address=""
                            data-flat=""
                            data-landmark=""
                            onfocus="this.placeholder = ''; handleLocationFocus('global')"
                            onblur="this.placeholder = 'Enter your current location'"
                            oninput="handleLocationInput('global')"
                        >
                        <div id="pickup-suggestions-global" class="suggestions-dropdown" style="top: 100%; z-index: 100;"></div>
                    </div>
                </div>
                
                <!-- Flex Spacer to push garage container to the bottom and expose the map -->
                <div style="flex-grow: 1; pointer-events: none; min-height: 25vh;"></div>

                <section class="card mt-20" id="inspection-approval-section"
                    style="display: none; background: rgba(245, 158, 11, 0.08); border: 1px solid var(--warning); backdrop-filter: blur(20px);">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                        <h3 style="color: var(--warning); font-weight: 700; display: flex; align-items: center; gap: 8px; margin: 0;">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; display: inline-block; color: var(--warning);"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg> Action Required
                        </h3>
                        <span style="font-size: 0.8rem; color: var(--text-main); font-weight: 600; padding: 4px 8px; background: rgba(255,255,255,0.1); border-radius: 6px;">Section 2 of 8</span>
                    </div>
                    <h4 style="font-size: 1.05rem; font-weight: 700; margin-bottom: 5px; color: var(--text-main);">Inspection Report: Brakes (60 Points)</h4>
                    <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 20px;">Review the marshal's findings and approve repairs to proceed with this section.</p>
                    <div id="inspection-approval-list" class="list-container">
                        <!-- Populated by JS -->
                    </div>
                </section>
 
                <section class="card mt-20" id="trips-section" style="display: none; background: rgba(250, 204, 21, 0.08); border: 1px solid var(--primary); backdrop-filter: blur(20px);">
                    <h3 style="color: var(--primary); font-weight: 700; margin-bottom: 15px;">Live 5-Step Protocol Tracking</h3>
                    <div id="trips-list" class="list-container">
                        <!-- Populated by JS -->
                    </div>
                </section>
 
                <section class="card mt-20" id="approval-section" style="display: none; background: rgba(20, 83, 45, 0.08); border: 1px solid #22c55e; backdrop-filter: blur(20px);">
                    <h3 style="color: #22c55e; font-weight: 700; margin-bottom: 5px; display: flex; align-items: center; gap: 8px;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; display: inline-block; color: #22c55e;"><polyline points="20 6 9 17 4 12"></polyline></svg> Dual Sign-off Complete
                    </h3>
                    <p style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: 20px;">Your vehicle is ready. Please review the transparent 5-line invoice to checkout.</p>
                    <div id="approval-list" class="list-container">
                        <!-- Populated by JS -->
                    </div>
                </section>
 
                <section class="card" id="location-placeholder-card" style="background: rgba(18, 22, 29, 0.85); backdrop-filter: blur(30px); -webkit-backdrop-filter: blur(30px); border-radius: 24px; padding: 24px; text-align: center; border: 1px solid rgba(255, 255, 255, 0.08); margin-bottom: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.3); transition: all 0.3s ease;">
                    <div style="display: flex; flex-direction: column; align-items: center; gap: 14px; padding: 10px 0;">
                        <div style="width: 52px; height: 52px; border-radius: 50%; background: rgba(250, 204, 21, 0.1); border: 1.5px solid rgba(250, 204, 21, 0.3); display: flex; align-items: center; justify-content: center; color: #facc15; font-size: 1.4rem; box-shadow: 0 0 15px rgba(250, 204, 21, 0.15);">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="color: #facc15;"><path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                        </div>
                        <h3 style="font-size: 1.25rem; font-weight: 800; color: #ffffff; margin: 0; font-family: 'Manrope', sans-serif;">Set Your Route</h3>
                        <p style="font-size: 0.85rem; color: var(--text-muted); margin: 0; max-width: 300px; line-height: 1.4;">Enter pickup location at the top and drop location below to view available vehicles and book your service.</p>
                    </div>
                </section>

                <!-- Drop Location Selector just above welcome back user -->
                <div class="drop-location-select-container" style="position: relative; width: 100%; z-index: 999; display: flex; flex-direction: column; gap: 6px; background: rgba(18, 22, 29, 0.95); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); padding: 14px; border-radius: 20px; border: 1px solid rgba(255, 255, 255, 0.08); box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5); margin-bottom: 20px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
                        <label style="font-size: 0.78rem; color: #fff; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px; display: flex; align-items: center; gap: 6px; margin: 0;">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                            Where to drop?
                        </label>
                        <button onclick="openRouteSearchModal('stop')" style="background: none; border: none; color: #facc15; font-size: 0.78rem; font-weight: bold; cursor: pointer; display: flex; align-items: center; gap: 4px; padding: 0; outline: none;">
                            <span class="material-symbols-outlined" style="font-size: 1rem; font-weight: 800;">add</span>
                            Add route
                        </button>
                    </div>
                    <div id="route-stops-list" style="display: none; flex-direction: column; gap: 8px; margin-top: 4px; margin-bottom: 4px;"></div>
                                        <div style="position: relative; width: 100%;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #22c55e;"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                        <input type="text" 
                            id="drop-location-global"
                            placeholder="Enter drop location" 
                            style="width: 100%; padding: 12px 14px 12px 42px; border-radius: 12px; border: 1px solid rgba(34, 197, 94, 0.4); background: rgba(0,0,0,0.5); color: #fff; font-size: 1.02rem; font-weight: 600; outline: none; transition: all 0.3s ease;"
                            autocomplete="off"
                            data-lat=""
                            data-lng=""
                            data-address=""
                            data-flat=""
                            data-landmark=""
                            onfocus="this.placeholder = ''; handleLocationFocus('global-drop')"
                            onblur="this.placeholder = 'Enter drop location'"
                            oninput="handleLocationInput('global-drop')"
                        >
                        <div id="drop-suggestions-global" class="suggestions-dropdown" style="top: 100%; z-index: 100;"></div>
                    </div>
                    <div id="route-stats-badge" style="display: none; align-items: center; gap: 8px; margin-top: 8px; font-family: 'Inter', sans-serif; background: rgba(0,0,0,0.3); padding: 8px 12px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.05); width: fit-content;">
                        <span style="font-size: 0.72rem; color: #a1a1aa; font-weight: 800; text-transform: uppercase; letter-spacing: 0.5px;">Est. Route:</span>
                        <span style="font-size: 0.82rem; color: #fff; font-weight: 800;"><span id="route-est-distance">-- km</span> • <span id="route-est-duration" style="color: #facc15;">-- mins</span></span>
                    </div>
                    <div id="clear-garage-selection-container" style="display: none; text-align: right; margin-top: 4px;">
                        <a href="javascript:void(0)" onclick="clearGarageSelection(); return false;" style="color: #facc15; font-size: 0.78rem; font-weight: bold; text-decoration: underline;">Switch to Point-to-Point Logistics</a>
